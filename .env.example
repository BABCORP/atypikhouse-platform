APP_ENV=local
APP_DEBUG=true
APP_URL=https://CHANGE_ME_RENDER_URL.onrender.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atypikhouse
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=

# Render / hébergement distant : utiliser soit DATABASE_URL, soit les variables DB_*.
# Exemple : mysql://user:password@host:3306/database
DATABASE_URL=
MYSQL_URL=
DB_SSL_CA=
DB_SSL_VERIFY=false

# Google Analytics / tracking
GA4_ID=
GTM_ID=

# Cookie consent
COOKIE_CONSENT_ENABLED=true

# SMTP / Brevo
SMTP_ENABLED=false
REAL_EMAIL_SENDING=false
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=b32f0f001@smtp-brevo.com
MAIL_PASSWORD=CHANGE_ME_BREVO_SMTP_PASSWORD
MAIL_FROM_ADDRESS=contact@atypikhouse.fr
MAIL_FROM_NAME=AtypikHouse
SMTP_TIMEOUT=3
BREVO_API_TIMEOUT=3
MAIL_PREFER_BREVO_API=true
ADMIN_EMAIL=admin@atypikhouse.fr
SUPPORT_EMAIL=support@atypikhouse.fr
DPO_EMAIL=dpo@atypikhouse.fr
ADMIN_NOTIFICATION_EMAIL=contact@atypikhouse.fr

# Demo mode
MAIL_DEMO_MODE=true
MAIL_LOG_ONLY=true

# Social media
INSTAGRAM_URL=https://www.instagram.com/atypikhouse__off/
FACEBOOK_URL=

# Emailing provider placeholders
EMAILING_PROVIDER=brevo
EMAILING_API_KEY=CHANGE_ME_BREVO_API_KEY
EMAILING_LIST_ID=

BREVO_API_KEY=CHANGE_ME_BREVO_API_KEY
BREVO_LIST_ID=
BREVO_ENABLED=false
