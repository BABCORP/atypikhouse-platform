APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8888/atypikhouse/public

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=atypikhouse
DB_USERNAME=root
DB_PASSWORD=root
DB_SOCKET=

# Render / hébergement distant : utiliser soit DATABASE_URL, soit les variables DB_*.
# Exemple : mysql://user:password@host:3306/database
DATABASE_URL=
MYSQL_URL=
DB_SSL_CA=
DB_SSL_VERIFY=false

# Google Analytics / tracking
GA4_ID=
GTM_ID=

# Cookie consent
COOKIE_CONSENT_ENABLED=true

# SMTP / Google SMTP
MAIL_MAILER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=contact@atypikhouse.fr
SMTP_FROM_NAME=AtypikHouse
ADMIN_NOTIFICATION_EMAIL=contact@atypikhouse.fr

# Demo mode
MAIL_DEMO_MODE=true
MAIL_LOG_ONLY=true

# Social media
INSTAGRAM_URL=https://www.instagram.com/atypikhouse__off/
FACEBOOK_URL=

# Emailing provider placeholders
EMAILING_PROVIDER=
EMAILING_API_KEY=
EMAILING_LIST_ID=

BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_ENABLED=false
